ARG PYTORCH_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel
FROM ${PYTORCH_IMAGE}

ARG TORCH_CUDA_ARCH_LIST=8.0
ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    FORCE_CUDA=1

WORKDIR /workspace/SAVAF-AV

RUN python -m pip install --break-system-packages \
        einops \
        librosa \
        soundfile \
        scipy \
        matplotlib \
        plyfile \
        tqdm \
        opencv-python-headless \
        tensorboard \
        lpips \
        pillow \
        jaxtyping

# Cache LPIPS backbones and linear heads so containers run without network access.
RUN python -c "import lpips, torch, torchvision; \
lpips.LPIPS(net='alex'); \
torchvision.models.vgg16(weights=torchvision.models.VGG16_Weights.IMAGENET1K_V1); \
[torch.hub.load_state_dict_from_url(f'https://raw.githubusercontent.com/richzhang/PerceptualSimilarity/master/lpips/weights/v0.1/{n}.pth', map_location='cpu') for n in ('alex', 'vgg')]"

COPY submodules/simple-knn /workspace/SAVAF-AV/submodules/simple-knn
COPY submodules/diff-gaussian-rasterization /workspace/SAVAF-AV/submodules/diff-gaussian-rasterization

RUN python -m pip uninstall -y diff_gaussian_rasterization simple_knn || true \
    && python -m pip install --break-system-packages --no-build-isolation --no-cache-dir \
        /workspace/SAVAF-AV/submodules/simple-knn \
    && python -m pip install --break-system-packages --no-build-isolation --no-cache-dir \
        /workspace/SAVAF-AV/submodules/diff-gaussian-rasterization \
    && python -c "import diff_gaussian_rasterization, simple_knn, torch; print(torch.__version__, torch.cuda.is_available())"

COPY . /workspace/SAVAF-AV

ENTRYPOINT ["bash", "-lc"]
CMD ["bash"]
